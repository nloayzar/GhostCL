#Output
outputfile = ./

#Evolution
expansion = false
evolver = LF

#Lattice
N = 512
dt = 0.05
kIR = .1

#Times
tOutputFreq = 10
tOutputInfreq = 100
tMax = 1e6

# Stability estimator
stabilityEstimator = true
stabilityEstimatorStopGChiThreshold = 1.0
stabilityEstimatorStopKPhiIntThreshold = 1.0

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 1
withGWs = false
grav_ON = false

#IC
kCutOff = 100
#ScalarICs = 1
#ScalarICTemperature = 0
initial_amplitudes = 0.0  # homogeneous amplitudes in GeV
initial_momenta = 0.0   # homogeneous amplitudes in GeV2

#Model Parameters
mass_phi = 1.0
mass_g = 1.1
lambda_phi = 1e-4
lambda_g = 1e-4
q = 0.1
