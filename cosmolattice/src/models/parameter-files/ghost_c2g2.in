#Output
outputfile = ./phi0_3e18_q20_No_grav/

#Evolution
expansion = false
evolver = RK2

#Lattice
N = 32
dt = 0.01
kIR = 1

#Times
tOutputFreq = 0.1
tOutputInfreq = 1
tMax = 60

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 1
withGWs = false
grav_ON = false

#IC
kCutOff = 100
initial_amplitudes = 3.39928e18  # homogeneous amplitudes in GeV
initial_momenta = -3.0714e31   # homogeneous amplitudes in GeV2

#Model Parameters
mass_phi = 1.5e13
mass_g = 1.5e13
q = 20