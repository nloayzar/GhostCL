#Output
outputfile = ./test_mp1e3/

#Evolution
expansion = false
evolver = RK2

#Lattice
N = 128
dt = 0.05
kIR = .1

#Times
tOutputFreq = 1
tOutputInfreq = 1
tMax = 200

#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 1
withGWs = false
grav_ON = true

#IC
kCutOff = 100
#ScalarICs = 1
#ScalarICTemperature = 0
initial_amplitudes = 3.39928e18  # homogeneous amplitudes in GeV
initial_momenta = -3.0714e31   # homogeneous amplitudes in GeV2

#Model Parameters
mass_phi = 1.0
mass_g = 1.1
q = 0.1
planckmass = 1e3